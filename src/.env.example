# =========================================================
# Application
# =========================================================
APP_NAME="Medical RAG App"
APP_VERSION="1.0.0"
SHOW_DEVELOPER_MODE=false
# =========================================================
# PostgreSQL Database
# =========================================================

POSTGRES_USER="YOUR_POSTGRES_USER"
POSTGRES_PASSWORD="YOUR_POSTGRES_PASSWORD"
POSTGRES_DB="med-rag"

POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5444

POSTGRES_URL="YOUR_ASYNC_POSTGRES_URL"
POSTGRES_SYNC_URL="YOUR_SYNC_POSTGRES_URL"


# =========================================================
# Vector Database
# =========================================================

VECTOR_DB_PROVIDER="PGVECTOR"
VECTOR_DB_TABLE="vector_documents"

VECTOR_DB_MIN_POOL_SIZE=1
VECTOR_DB_MAX_POOL_SIZE=10

# Must match the embedding model output dimension
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL_SIZE=384

VECTOR_DISTANCE_METHOD="cosine"
VECTOR_INDEX_TYPE="hnsw"
VECTOR_SEARCH_LIMIT=5


# =========================================================
# Embeddings and Reranking
# =========================================================

EMBEDDING_BACKEND="COHERE"

COHERE_API_KEY="YOUR_COHERE_API_KEY"
COHERE_EMBEDDING_MODEL="embed-multilingual-light-v3.0"
COHERE_EMBEDDING_BATCH_SIZE=96
COHERE_TRUNCATE="END"

# embed-multilingual-light-v3.0 returns 384-dimensional vectors
COHERE_RERANK_MODEL="rerank-v3.5"
# =========================================================
# Intent Understanding
# =========================================================
INTENT_PROVIDER="gemini"
INTENT_MODEL="gemini-3.6-flash"
INTENT_MODEL_MAX_OUTPUT_TOKENS=320

GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Kept as a general Gemini fallback setting
GEMINI_GENERATION_MODEL="gemini-3.6-flash"


# =========================================================
# Main RAG Answer Generation
# Groq generates the final grounded answer
# =========================================================

GENERATION_PROVIDER="groq"

GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_GENERATION_MODEL="openai/gpt-oss-120b"

RAG_MAX_CONTEXT_CHARACTERS=24000


# =========================================================
# Keyword Translation
# =========================================================

KEYWORD_TRANSLATION_PROVIDER="groq"
KEYWORD_TRANSLATION_MODEL="openai/gpt-oss-120b"


# =========================================================
# Claim Judgment
# =========================================================

CLAIM_JUDGE_PROVIDER="groq"
CLAIM_JUDGE_MODEL="openai/gpt-oss-20b"

CLAIM_SUPPORT_THRESHOLD=0.80
CLAIM_JUDGE_MAX_OUTPUT_TOKENS=300
CLAIM_JUDGE_MALFORMED_RESPONSE_RETRIES=1


# =========================================================
# Citation Repair and Answer Rebuilding
# =========================================================

CITATION_REPAIR_MAX_OUTPUT_TOKENS=700
SUPPORTED_ANSWER_REBUILDER_MAX_OUTPUT_TOKENS=500


# =========================================================
# Retrieval Retry
# Currently uses the provider configured by the factory
# =========================================================

RETRIEVAL_RETRY_MAX_OUTPUT_TOKENS=350


# =========================================================
# RAG Relevance and Evidence
# =========================================================

RAG_RELEVANCE_THRESHOLD=0.320982
RAG_MIN_RELEVANT_CHUNKS=1

RAG_STRONG_EVIDENCE_THRESHOLD=0.533
RAG_CANDIDATE_ABSOLUTE_THRESHOLD=0.0
RAG_CANDIDATE_RELATIVE_TO_TOP_RATIO=0.0


# =========================================================
# Faithfulness and Unsupported Claims
# =========================================================

RAG_MIN_FAITHFULNESS=0.90
RAG_BLOCK_ON_ANY_UNSUPPORTED_CLAIM=true


# =========================================================
# Citation Evaluation
# =========================================================

RAG_MIN_CITATION_ACCURACY=0.95
RAG_MIN_CITATION_COMPLETENESS=1.0


# =========================================================
# Optional GLM Provider
# =========================================================

ZENMUX_API_KEY="YOUR_ZENMUX_API_KEY"

GLM_BASE_URL="https://api.z.ai/api/paas/v4/"
GLM_GENERATION_MODEL="glm-4.7-flash"
GLM_TIMEOUT_SECONDS=120


# =========================================================
# Optional Manus Provider
# =========================================================

MANUS_API_KEY="YOUR_MANUS_API_KEY"
MANUS_AGENT_PROFILE="manus-1.6"


# =========================================================
# Email / SMTP
# =========================================================

SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=465

SMTP_USERNAME="yk784037@gmail.com"
SMTP_PASSWORD="YOUR_GMAIL_APP_PASSWORD"
EMAIL_FROM="yk784037@gmail.com"


# =========================================================
# Authentication
# =========================================================

JWT_SECRET_KEY="YOUR_LONG_RANDOM_JWT_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30


# =========================================================
# Global Project
# =========================================================
GLOBAL_PROJECT_ID=2