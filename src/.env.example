APP_NAME="Medical RAG App"
APP_VERSION="1.0.0"

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_DB=med-rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5444

POSTGRES_URL=postgresql+asyncpg://postgres:replace_with_your_password@127.0.0.1:5444/med-rag
POSTGRES_SYNC_URL=postgresql+psycopg2://postgres:replace_with_your_password@127.0.0.1:5444/med-rag

# Vector database
VECTOR_DB_PROVIDER=PGVECTOR
VECTOR_DB_TABLE=vector_documents
VECTOR_DB_MIN_POOL_SIZE=1
VECTOR_DB_MAX_POOL_SIZE=10
VECTOR_DISTANCE_METHOD=cosine
VECTOR_INDEX_TYPE=hnsw
VECTOR_SEARCH_LIMIT=5

# Embeddings
EMBEDDING_BACKEND=COHERE
COHERE_API_KEY=replace_with_your_cohere_api_key
COHERE_EMBEDDING_MODEL=embed-multilingual-light-v3.0
COHERE_EMBEDDING_BATCH_SIZE=96
COHERE_TRUNCATE=END
EMBEDDING_MODEL_SIZE=384
COHERE_RERANK_MODEL=rerank-v4.0-pro